{
  "$schema": "https://raw.githubusercontent.com/amzn/style-dictionary/main/schema.json",
  "_comment": "Portable mirror of tokens.css for non-Tailwind consumers (Figma token plugins, design QA, other apps). tokens.css is canonical — if the two ever disagree, tokens.css wins. Update both together.",
  "color": {
    "cream": {
      "50": { "value": "#FBF6EF", "comment": "Paper — cards, popovers, input fill" },
      "100": { "value": "#F6E9D8", "comment": "Latte — default page background" },
      "200": { "value": "#EEDBC0", "comment": "hover fill on cream surfaces" },
      "300": { "value": "#E0C49D", "comment": "borders/dividers on cream" }
    },
    "espresso": {
      "950": { "value": "#241209", "comment": "primary text, headlines, icon ink" },
      "800": { "value": "#3A2417", "comment": "secondary headings" },
      "600": { "value": "#6B4A38", "comment": "body copy on cream" },
      "400": { "value": "#93705A", "comment": "muted / placeholder text" },
      "200": { "value": "#D9C3AE", "comment": "disabled text on cream" }
    },
    "ember": {
      "500": { "value": "#E2572B", "comment": "decorative only — 3.7:1 on cream, not for small text" },
      "600": { "value": "#C4441E", "comment": "interactive fill / solid buttons — 5.0:1 on white" },
      "700": { "value": "#A3350F", "comment": "pressed state" }
    },
    "gold": {
      "500": { "value": "#C89A2C", "comment": "badge fill — pair with espresso-950 icon/text only" },
      "700": { "value": "#8F6C17", "comment": "text-safe on cream, 4.6:1" }
    },
    "pine": {
      "600": { "value": "#2E6657", "comment": "badge fill — white text/icon safe, 6.7:1" },
      "700": { "value": "#1F4A3F" }
    },
    "berry": {
      "500": { "value": "#C1557B", "comment": "badge fill, icon-only" },
      "600": { "value": "#A8446A", "comment": "text-safe on white, 5.7:1" }
    },
    "semantic": {
      "background": { "value": "{color.cream.100}" },
      "surface": { "value": "{color.cream.50}" },
      "surface-hover": { "value": "{color.cream.200}" },
      "border": { "value": "{color.cream.300}" },
      "ink": { "value": "{color.espresso.950}" },
      "ink-muted": { "value": "{color.espresso.600}" },
      "ink-faint": { "value": "{color.espresso.400}" },
      "accent": { "value": "{color.ember.600}" },
      "accent-decorative": { "value": "{color.ember.500}" },
      "accent-hover": { "value": "{color.ember.700}" },
      "focus-ring": { "value": "{color.ember.600}" }
    }
  },
  "font": {
    "family": {
      "display": { "value": "Fredoka, ui-rounded, 'Segoe UI', sans-serif", "comment": "headlines, eyebrows, wordmark only" },
      "sans": { "value": "'Plus Jakarta Sans', ui-sans-serif, system-ui, sans-serif", "comment": "body copy" },
      "mono": { "value": "'Space Mono', ui-monospace, 'SFMono-Regular', monospace", "comment": "prices, timestamps, ticket labels" }
    },
    "size": {
      "xs": { "value": "0.75rem", "lineHeight": "1rem" },
      "sm": { "value": "0.875rem", "lineHeight": "1.375rem" },
      "base": { "value": "1rem", "lineHeight": "1.625rem" },
      "lg": { "value": "1.125rem", "lineHeight": "1.75rem" },
      "xl": { "value": "1.25rem", "lineHeight": "1.875rem" },
      "2xl": { "value": "1.5rem", "lineHeight": "2rem" },
      "3xl": { "value": "1.875rem", "lineHeight": "2.25rem" },
      "4xl": { "value": "2.5rem", "lineHeight": "2.75rem" },
      "5xl": { "value": "3.25rem", "lineHeight": "3.5rem" },
      "6xl": { "value": "4rem", "lineHeight": "1.05" }
    },
    "tracking": {
      "tight": { "value": "-0.02em", "comment": "display headlines" },
      "normal": { "value": "0em" },
      "wide": { "value": "0.04em", "comment": "nav links" },
      "ticket": { "value": "0.12em", "comment": "uppercase mono eyebrows/labels" }
    }
  },
  "spacing": {
    "gutter": { "value": "1.5rem", "comment": "mobile page margin" },
    "gutter-lg": { "value": "4rem", "comment": "desktop page margin" },
    "section-y": { "value": "5rem" },
    "section-y-lg": { "value": "7.5rem" },
    "stack": { "value": "1rem" }
  },
  "radius": {
    "sm": { "value": "0.5rem", "comment": "inputs, tags" },
    "md": { "value": "1rem", "comment": "cards, popovers" },
    "lg": { "value": "1.5rem", "comment": "hero image frame, large panels" },
    "xl": { "value": "2rem", "comment": "feature panels" },
    "pill": { "value": "999px", "comment": "buttons, search bar, nav pills" }
  },
  "shadow": {
    "soft": { "value": "0 8px 24px -8px rgb(36 18 9 / 0.18)" },
    "lift": { "value": "0 16px 40px -12px rgb(36 18 9 / 0.28)" },
    "button": { "value": "0 4px 12px -2px rgb(196 68 30 / 0.35)", "comment": "ember-tinted, not neutral" }
  },
  "border": {
    "width": {
      "hairline": { "value": "1px" },
      "ticket": { "value": "2px", "comment": "dashed, used for receipt-edge motif" }
    }
  },
  "motion": {
    "ease": {
      "brew": { "value": "cubic-bezier(0.22, 1, 0.36, 1)", "comment": "confident settle, no bounce" }
    },
    "duration": {
      "fast": { "value": "150ms" },
      "base": { "value": "220ms" },
      "slow": { "value": "400ms" }
    }
  }
}
